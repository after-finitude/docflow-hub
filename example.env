#

LOG_LEVEL=debug

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
#
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docflow

POSTGRES_USER=docflow_owner
POSTGRES_PASSWORD=change_me_owner

#
APP_DB_PASSWORD=change_me_app

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONCURRENCY_DEFAULT=4
QUEUE_CONCURRENCY_OCR=2
QUEUE_CONCURRENCY_EXTRACT=2

# ─── MinIO (S3-compatible) ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=docflow
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=docflow
SIGNED_URL_TTL_SECONDS=900

MINIO_PUBLIC_URL=http://localhost:9000

# ─── OCR ─────────────────────────────────────────────────────────────────────
OCR_PROVIDER=mock
# Encrypted envelopes only; see docs/configuration.md for key provisioning.
# API_INTEGRATION_KEY_DIR=/secure/docflow/api-key
# WORKER_INTEGRATION_KEY_DIR=/secure/docflow/worker-key
# Native processes also need INTEGRATION_KEY_FILE=/secure/integration.key
# GOOGLE_VISION_KEY_FILE=/run/integrations/vision.enc
OCR_RENDER_DPI=200
OCR_LANGUAGE_HINTS=ru,en

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
# LLM_BASE_URL=
# LLM_API_KEY_FILE=/run/integrations/llm.enc
# LLM_MODEL=
LLM_TIMEOUT_MS=120000

EXPORT_DEFAULT_DESTINATION=file_json
# GOOGLE_SHEETS_KEY_FILE=/run/integrations/sheets.enc
# GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Documents

#
SOURCE_PROVIDER=local_folder
LOCAL_SOURCE_DIR=/data/source
SOURCE_SYNC_INTERVAL_SECONDS=300
# GOOGLE_DRIVE_KEY_FILE=/run/integrations/drive.enc
# GOOGLE_DRIVE_FOLDER_ID=

RETENTION_DAYS=90
ORPHAN_TTL_HOURS=24
RETENTION_INTERVAL_SECONDS=3600

JWT_SECRET=change_me_at_least_32_characters_long
JWT_EXPIRES_IN=8h

COOKIE_SECURE=false

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

SEED_OPERATOR_LOGIN=operator
SEED_OPERATOR_PASSWORD=operator_password
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin_password

API_PORT=3001

API_HOST_PORT=3001
WEB_HOST_PORT=3000
