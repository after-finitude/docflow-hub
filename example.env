# Docflow Hub — пример конфигурации. Скопировать в .env и заполнить.
# Реальные секреты в репозиторий не попадают (ТЗ §11).
#
# NODE_ENV здесь намеренно нет: в контейнерах его задаёт образ, при локальной
# разработке действует значение по умолчанию (development).

LOG_LEVEL=debug

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Строки подключения собираются из этих частей в packages/core/src/config/env.ts.
# Готовых URL в конфигурации нет намеренно: пароль, записанный в двух местах,
# рано или поздно разъезжается, и отказ виден только как ошибка аутентификации.
#
# Для запуска без Docker заменить POSTGRES_HOST на localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docflow

# Владелец схемы: под ним выполняются миграции и seed.
POSTGRES_USER=docflow_owner
POSTGRES_PASSWORD=change_me_owner

# Пароль роли приложения docflow_app — у неё нет UPDATE/DELETE на audit_events
# (ТЗ §11). Имя роли зафиксировано в коде, init-скрипте и миграции.
#
# Внимание: роль создаётся только при первичной инициализации кластера.
# Смена пароля позже требует ALTER ROLE вручную либо удаления тома postgres-data.
APP_DB_PASSWORD=change_me_app

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# Параллелизм воркеров: общее значение и точечные переопределения по очередям.
QUEUE_CONCURRENCY_DEFAULT=4
QUEUE_CONCURRENCY_OCR=2
QUEUE_CONCURRENCY_EXTRACT=2

# ─── MinIO (S3-compatible) ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=docflow
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=docflow
# Срок жизни подписанной ссылки на оригинал, секунды (ТЗ §11 — 15 минут).
SIGNED_URL_TTL_SECONDS=900

# ─── Аутентификация ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Флаг Secure у session-cookie. Обязательно true при развёртывании за TLS.
# При true и работе по обычному HTTP браузер отбрасывает cookie: сервер
# отвечает 200, а сессия не сохраняется — вход ломается без сообщения.
COOKIE_SECURE=false

# Ограничение частоты попыток входа: попыток за окно, с одного адреса.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# ─── Seed-пользователи (ТЗ 3.1) ──────────────────────────────────────────────
SEED_OPERATOR_LOGIN=operator
SEED_OPERATOR_PASSWORD=operator_password
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin_password

# ─── Порты ───────────────────────────────────────────────────────────────────
# Порт, который приложение слушает при запуске без Docker. Внутри контейнера
# порт зафиксирован в docker-compose.yml и этой переменной не управляется.
API_PORT=3001

# Порты, публикуемые compose на хост-машине.
API_HOST_PORT=3001
WEB_HOST_PORT=3000
