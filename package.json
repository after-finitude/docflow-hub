{
  "name": "docflow-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Docflow Hub — AI Document Operations Hub",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "oxlint",
    "dataset": "node scripts/generate-dataset.mjs",
    "eval": "tsc -b && node scripts/eval.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "tsc -b && node --test 'packages/shared/dist/**/*.test.js' scripts/extraction.test.mjs",
    "verify": "bash scripts/verify.sh",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @docflow/core",
    "db:migrate": "npm run db:migrate -w @docflow/core",
    "db:seed": "npm run db:seed -w @docflow/core",
    "dev:api": "npm run dev -w @docflow/api",
    "dev:worker": "npm run dev -w @docflow/worker",
    "dev:web": "npm run dev -w @docflow/web"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^24.13.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "oxlint": "^1.76.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
